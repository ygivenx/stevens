def port_free(port):
    for host in ('127.0.0.1', '::1'):
        family = socket.AF_INET6 if ':' in host else socket.AF_INET
        s = socket.socket(family)
        s.settimeout(2)
        try:
            s.connect((host, port))
            s.close()
            return False
        except OSError:
            pass
    return True


def read_agent_token():
    env_path = os.path.join(ROOT, '.env.local')
    if not os.path.exists(env_path):
        return None
    with open(env_path) as f:
        for line in f:
            if line.startswith('STEVENS_AGENT_TOKEN='):
                return line.strip().split('=', 1)[1]
    return None


def viewer_id(role, scn='helios'):
    cfg = scenario_config(scn) or SCENARIOS['helios']
    if role == 'Associate':
        return cfg['owner']
    if role == 'Partner':
        return cfg['reviewer']
    return role


def http_json(method, path, role=None, timeout=30, data=None, base='http://localhost:8787', agent=False, viewer=False, scn='helios'):
    headers = {}
    if agent:
        if role != 'nobody':
            token = read_agent_token()
            if token:
                headers['X-Stevens-Agent'] = token
    elif viewer:
        if role and role != 'nobody':
            headers['X-Viewer-Id'] = viewer_id(role, scn)
    elif role:
        headers['X-Viewer-Role'] = role
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        headers['Content-Type'] = 'application/json'
    req = urllib.request.Request(base + path, data=body, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, json.load(resp)


def server_healthy(port):
    try:
        req = urllib.request.Request('http://localhost:%d/api/health' % port)
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception:
        return False


def stack_healthy(scn=None):
    cfg = scenario_config(scn or 'helios') or SCENARIOS['helios']
    return server_healthy(cfg['firm']) and server_healthy(cfg['personal'])


def check_tool(name, want, fix):
    path = shutil.which(name)
    if not path:
        return fail('%s is missing; %s' % (name, fix))
    if name == 'node':
        out = subprocess.run([path, '--version'], capture_output=True, text=True)
        major = int(out.stdout.strip().lstrip('v').split('.')[0])
        if major < 20:
            return fail('node %s is below 20; %s' % (out.stdout.strip(), fix))
        print('ok: node %s at %s' % (out.stdout.strip(), path))
    else:
        print('ok: %s at %s' % (name, path))
    return 0


