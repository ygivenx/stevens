def cmd_test(argv):
    if '--help' in argv:
        print('stevensctl test: run typecheck + vitest + build.\n')
        print('Runs the server and web typechecks, the vitest suites, and the build.')
        print('Prints one line per suite.\n')
        print('Examples:')
        print('  stevensctl test')
        return 0
    suites = [
        ('typecheck-server', ['npx', 'tsc', '-p', 'tsconfig.server.json', '--noEmit']),
        ('typecheck-web', ['npx', 'tsc', '--noEmit', '-p', 'web/tsconfig.json']),
        ('vitest', ['npm', 'test']),
        ('build', ['npm', 'run', 'build']),
    ]
    failed = []
    for label, cmd in suites:
        plus(' '.join(cmd))
        proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
        print('%s: %s' % (label, 'PASS' if proc.returncode == 0 else 'FAIL'))
        if proc.returncode != 0:
            failed.append(label)
            print(proc.stdout[-2000:] + proc.stderr[-2000:])
    if failed:
        return fail('suites failed: %s' % ', '.join(failed))
    print('test: PASS')
    return 0


