def cmd_doctor(argv):
    if '--help' in argv:
        print('stevensctl doctor: check tools and credentials.\n')
        print('Checks node 20+, uv, ffmpeg; MODEL_API_KEY in .env.local (never printed);')
        print('GET /v1/models lists the SPEC models; FIRM_ADMIN/DATABASE_URL connect (never')
        print('printed); ports 5173, 5174, 8787 and 8788 state.\n')
        print('Examples:')
        print('  stevensctl doctor')
        return 0
    rc = 0
    rc |= check_tool('node', '20+', 'install node 20 or newer')
    rc |= check_tool('uv', 'any', 'install uv from docs.astral.sh/uv')
    rc |= check_tool('ffmpeg', 'any', 'install ffmpeg')
    key = read_key()
    if not key:
        rc |= fail('MODEL_API_KEY is not set in .env.local; add MODEL_API_KEY=<key>')
    else:
        print('ok: MODEL_API_KEY is set (%d chars, not shown)' % len(key))
        plus('GET https://api.meta.ai/v1/models')
        try:
            req = urllib.request.Request(
                'https://api.meta.ai/v1/models',
                headers={'Authorization': 'Bearer ' + key},
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                listed = [m['id'] for m in json.load(resp)['data']]
            missing = [m for m in EXPECTED_MODELS if m not in listed]
            if missing:
                rc |= fail('GET /v1/models lacks %s; check the key region' % ', '.join(missing))
            else:
                print('ok: GET /v1/models lists %s' % ', '.join(EXPECTED_MODELS))
        except Exception as e:
            rc |= fail('GET /v1/models failed (%s); check network and key' % e)
    for key in ('FIRM_ADMIN_DATABASE_URL', 'FIRM_DATABASE_URL'):
        url = read_env_value(key)
        if not url:
            rc |= fail('%s is not set in .env.local; run stevensctl crm-db up, then npx tsx scripts/firm-crm-setup.ts' % key)
        elif not pg_ok(url):
            rc |= fail('%s does not connect; run stevensctl crm-db up, then npx tsx scripts/firm-crm-setup.ts' % key)
        else:
            print('ok: %s connects (not shown)' % key)
    for port in (5173, 5174, 8787, 8788):
        if port_free(port):
            print('ok: port %d free' % port)
        else:
            print('ok: port %d in use (verify it is this instance before stack up)' % port)
    if rc == 0:
        print('doctor: PASS')
    return rc


def stack_pidfile(name):
    return os.path.join(instance_dir(name), 'stack.pid')


def stack_logfile(name):
    return os.path.join(instance_dir(name), 'stack.log')


def stack_running(name):
    pidfile = stack_pidfile(name)
    if not os.path.exists(pidfile):
        return False
    try:
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        os.killpg(pgid, 0)
        return True
    except Exception:
        return False


def cmd_stack(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv or not argv or argv[0].startswith('--'):
        print('stevensctl stack: run the local stack for one instance.\n')
        print('Usage: stevensctl stack up|down|logs|restart|status [--instance NAME] [--scenario helios|forge|mercy] [--now ISO]\n')
        print('up starts npm run dev (helios yours :5173+:8788, firm :5174+:8787; forge :5273+:8888')
        print('and :5274+:8887; mercy :5373+:8988 and :5374+:8987) and waits for health;')
        print('the stack is sealed: STEVENS_DATA_DIR points at this instance, sources point')
        print('at fixtures, and real tokens are unset, so verify flows never touch owner data;')
        print('down stops only this instance; logs tails its log; status prints health.\n')
        print('Examples:')
        print('  export STEVENS_VERIFY_INSTANCE=day2')
        print('  stevensctl stack up')
        print('  stevensctl stack up --scenario forge')
        print('  stevensctl stack status')
        return 0 if '--help' in argv else 2
    scn = instance_scenario(name, argv)
    cfg = scenario_config(scn)
    if cfg is None:
        return fail('unknown scenario %s (helios|forge|mercy)' % scn)
    ports = (cfg['yours_web'], cfg['firm_web'], cfg['firm'], cfg['personal'])
    verb = argv[0]
    if verb == 'up':
        if stack_running(name):
            print('stack already up for instance %s' % name)
            return 0
        if not all(port_free(port) for port in ports):
            return fail('ports %s are held by another stack; stop it first' % '/'.join(str(p) for p in ports))
        now = None
        if '--now' in argv:
            i = argv.index('--now')
            if i + 1 >= len(argv):
                return fail('stack up --now needs an ISO timestamp')
            now = argv[i + 1]
        logpath = stack_logfile(name)
        plus('npm run dev > %s' % logpath)
        log = open(logpath, 'a')
        env = dict(os.environ)
        data = instance_data_dir(name)
        for processdir in ('firm', 'personal'):
            processdir_path = os.path.join(data, processdir)
            os.makedirs(processdir_path, exist_ok=True)
            with open(os.path.join(processdir_path, 'meta-fake.json'), 'w') as f:
                json.dump({'mode': 'normal'}, f)
            with open(os.path.join(processdir_path, 'meta-calls.json'), 'w') as f:
                json.dump({'count': 0}, f)
        env.update(sealed_env(name, scn))
        plus('STEVENS_DATA_DIR=%s (sealed: fixtures only, real sources unset)' % data)
        plus('scenario %s (fixtures %s)' % (scn, cfg['fixtures']))
        if now:
            env['STEVENS_NOW'] = now
            plus('STEVENS_NOW=%s' % now)
        with open(scenario_file(name), 'w') as f:
            f.write(scn)
        proc = subprocess.Popen(['npm', 'run', 'dev'], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True, env=env)
        with open(stack_pidfile(name), 'w') as f:
            f.write(str(proc.pid))
        for _ in range(60):
            if stack_healthy(scn):
                print('stack up: instance %s healthy (pgid %d)' % (name, proc.pid))
                return 0
            time.sleep(2)
        return fail('stack did not turn healthy in 120s; see stevensctl stack logs')
    if verb == 'down':
        pidfile = stack_pidfile(name)
        if not os.path.exists(pidfile):
            print('stack down: instance %s was not up' % name)
            return 0
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        plus('kill pgid %d' % pgid)
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        respawned = firm_pidfile(name)
        if os.path.exists(respawned):
            try:
                with open(respawned) as f:
                    os.kill(int(f.read().strip()), signal.SIGTERM)
            except (ProcessLookupError, ValueError):
                pass
            os.remove(respawned)
        os.remove(pidfile)
        print('stack down: instance %s stopped' % name)
        return 0
    if verb == 'logs':
        logpath = stack_logfile(name)
        if not os.path.exists(logpath):
            return fail('no log for instance %s; run stack up first' % name)
        plus('tail -n 50 %s' % logpath)
        out = subprocess.run(['tail', '-n', '50', logpath], capture_output=True, text=True)
        print(out.stdout, end='')
        return 0
    if verb == 'restart':
        now_args = []
        if '--now' in argv:
            now_args = ['--now', argv[argv.index('--now') + 1]]
        rc = cmd_stack(['down', '--instance', name])
        if rc != 0:
            return rc
        for _ in range(30):
            if all(port_free(port) for port in ports):
                break
            time.sleep(1)
        return cmd_stack(['up', '--instance', name, '--scenario', scn] + now_args)
    if verb == 'status':
        print('instance: %s' % name)
        print('scenario: %s' % scn)
        print('stack process: %s' % ('up' if stack_running(name) else 'down'))
        print('port %d (yours web): %s' % (cfg['yours_web'], 'free' if port_free(cfg['yours_web']) else 'in use'))
        print('port %d (firm web): %s' % (cfg['firm_web'], 'free' if port_free(cfg['firm_web']) else 'in use'))
        print('port %d (firm): %s' % (cfg['firm'], 'free' if port_free(cfg['firm']) else 'in use'))
        print('port %d (yours): %s' % (cfg['personal'], 'free' if port_free(cfg['personal']) else 'in use'))
        print('health firm :%d: %s' % (cfg['firm'], 'ok' if server_healthy(cfg['firm']) else 'down'))
        print('health yours :%d: %s' % (cfg['personal'], 'ok' if server_healthy(cfg['personal']) else 'down'))
        if scn == 'helios':
            crm_url = read_env_value('FIRM_DATABASE_URL')
            if not crm_url:
                print('health firm crm :5433: not configured (run stevensctl crm-db up)')
            else:
                print('health firm crm :5433: %s' % ('ok' if pg_ok(crm_url) else 'down'))
        else:
            print('health firm crm: file mode (crm.json, no Postgres)')
        print('data dir: %s' % instance_data_dir(name))
        return 0
    print('unknown stack verb: %s (see stevensctl stack --help)' % verb, file=sys.stderr)
    return 2


def cmd_seed(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv:
        print('stevensctl seed: stage fixtures + fresh ledger for this instance.\n')
        print('Usage: stevensctl seed [--instance NAME] [--scenario helios|forge|mercy]\n')
        print('Verifies the scenario manifest.json, rebuilds this instance vault from')
        print('personal/vault/, empties its inbox, truncates both process')
        print('ledgers, resets the Meta call counter and sets the fake to normal.')
        print('Runs firm-crm-setup for helios so the firm syncs from Postgres, then restarts.')
        print('Other scenarios run the firm on crm.json (file mode, no Postgres).\n')
        print('Examples:')
        print('  stevensctl stack up && stevensctl seed')
        print('  stevensctl stack up --scenario forge && stevensctl seed --scenario forge')
        return 0
    scn = instance_scenario(name, argv)
    cfg = scenario_config(scn)
    if cfg is None:
        return fail('unknown scenario %s (helios|forge|mercy)' % scn)
    base = os.path.join(ROOT, cfg['fixtures'])
    if not stack_running(name):
        print('seed refuses: this instance stack is not up (run stevensctl stack up first).', file=sys.stderr)
        return 2
    manifest = os.path.join(base, 'manifest.json')
    if not os.path.exists(manifest):
        return fail('%s/manifest.json is missing; cannot seed' % cfg['fixtures'])
    with open(manifest) as f:
        entries = json.load(f)
    for entry in entries:
        blob = os.path.join(base, entry['file'])
        if not os.path.exists(blob):
            return fail('fixture blob %s is missing; cannot seed' % entry['file'])
    vault_src = os.path.join(base, 'personal', 'vault')
    if not os.path.isdir(vault_src):
        return fail('%s/personal/vault/ is missing; cannot seed' % cfg['fixtures'])
    datadir = instance_data_dir(name)
    os.makedirs(datadir, exist_ok=True)
    plus('rebuild instance vault + inbox, truncate both ledgers, fake mode normal')
    for processdir in ('firm', 'personal'):
        processdir_path = os.path.join(datadir, processdir)
        os.makedirs(processdir_path, exist_ok=True)
        open(os.path.join(processdir_path, 'ledger.jsonl'), 'w').close()
        for stale in ('firm.db', 'personal.db', 'stage-cache', 'work'):
            stale_path = os.path.join(processdir_path, stale)
            if os.path.isdir(stale_path):
                shutil.rmtree(stale_path)
            elif os.path.exists(stale_path):
                os.remove(stale_path)
    inbox = os.path.join(datadir, 'personal', 'inbox')
    if os.path.isdir(inbox):
        shutil.rmtree(inbox)
    os.makedirs(inbox, exist_ok=True)
    vault = os.path.join(datadir, 'personal', 'vault')
    if os.path.isdir(vault):
        shutil.rmtree(vault)
    shutil.copytree(vault_src, vault)
    for processdir in ('firm', 'personal'):
        with open(os.path.join(datadir, processdir, 'meta-calls.json'), 'w') as f:
            json.dump({'count': 0}, f)
        with open(os.path.join(datadir, processdir, 'meta-fake.json'), 'w') as f:
            json.dump({'mode': 'normal'}, f)
    with open(os.path.join(datadir, 'meta-calls.json'), 'w') as f:
        json.dump({'count': 0}, f)
    with open(os.path.join(datadir, 'meta-fake.json'), 'w') as f:
        json.dump({'mode': 'normal'}, f)
    derived = os.path.join(datadir, 'derived')
    if os.path.exists(derived):
        shutil.rmtree(derived)
    print('seed: %d fixtures verified, state fresh, fake normal, counter 0' % len(entries))
    if scn == 'helios':
        plus('npx tsx scripts/firm-crm-setup.ts')
        setup = subprocess.run(['npx', 'tsx', 'scripts/firm-crm-setup.ts'], cwd=ROOT, capture_output=True, text=True, timeout=120)
        print(setup.stdout, end='')
        if setup.returncode != 0:
            return fail('firm-crm-setup failed; run stevensctl crm-db up first (%s)' % setup.stderr.strip()[-200:])
    else:
        print('seed: scenario %s runs the firm on crm.json (file mode, no Postgres)' % scn)
    print('seed: restarting the stack so both processes rebuild from fixtures')
    restart_argv = ['restart', '--instance', name, '--scenario', scn]
    if '--now' in argv:
        restart_argv += ['--now', argv[argv.index('--now') + 1]]
    return cmd_stack(restart_argv)


def json_path(doc, path):
    node = doc
    for part in path.split('.'):
        if '[' in part:
            key, rest = part.split('[', 1)
            idx = int(rest.rstrip(']'))
            node = node[key][idx]
        else:
            node = node[part] if isinstance(node, dict) and part in node else None
        if node is None:
            return None
    return node


def cmd_api(argv):
    if '--help' in argv or '--as' not in argv:
        print('stevensctl api: drive the app HTTP surface as a role.\n')
        print('Usage: stevensctl api --as Associate|Partner [--via yours|firm|agent] SURFACE [--expect CODE] [--field PATH] [--save FILE] [--until PATH] [--instance NAME]\n')
        print('Surfaces (yours :8788): health, state, items/<id>, ask, share/<claimId>, receipts/<id>.')
        print('Surfaces (firm :8787): health, people, state, approve/<id>, reject/<id>, media/<id>, receipts/<id>.')
        print('Surfaces (agent :8787): me, meetings, context, privy.')
        print('Legacy v2.1 surfaces (firm :8787): ingest, extract, bridge, brief, ask, switch, transcript/<id>, release/<id>.')
        print('--field prints one JSON path; --until polls until it is truthy (30s); --data sends a JSON body; --save stores it.')
        print('until that path is truthy (30s); --save stores the body under evidence.\n')
        print('Examples:')
        print('  stevensctl api --as Associate state --expect 200 --field events --save state.json')
        print('  stevensctl api --as Associate ingest --expect 200')
        return 0 if '--help' in argv else 2
    role = argv[argv.index('--as') + 1]
