def scenario_arg(argv):
    if '--scenario' in argv:
        i = argv.index('--scenario')
        if i + 1 >= len(argv):
            return None
        return argv[i + 1]
    return os.environ.get('STEVENS_SCENARIO')


def scenario_file(name):
    return os.path.join(instance_dir(name), 'scenario')


def instance_scenario(name, argv):
    explicit = scenario_arg(argv)
    if explicit:
        return explicit
    path = scenario_file(name)
    if os.path.exists(path):
        with open(path) as f:
            stored = f.read().strip()
        if stored:
            return stored
    return 'helios'


def scenario_config(name):
    if name not in SCENARIOS:
        return None
    return SCENARIOS[name]


def instance_name(argv):
    if '--instance' in argv:
        i = argv.index('--instance')
        if i + 1 >= len(argv):
            return None
        return argv[i + 1]
    explicit = scenario_arg(argv)
    if explicit:
        return explicit
    return os.environ.get('STEVENS_VERIFY_INSTANCE', 'default')


def instance_dir(name):
    path = os.path.join('/tmp/stevens-verify', name)
    os.makedirs(path, exist_ok=True)
