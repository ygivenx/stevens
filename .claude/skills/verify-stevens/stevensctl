def record_http(method, port, path, data=None, viewer=None):
    url = 'http://localhost:%d%s' % (port, path)
    body = json.dumps(data).encode() if data is not None else None
    headers = {}
    if data is not None:
        headers['Content-Type'] = 'application/json'
    if viewer:
        headers['X-Viewer-Id'] = viewer
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()


def record_state(port, viewer=None):
    status, body = record_http('GET', port, '/api/state', viewer=viewer)
    if status != 200:
        raise RuntimeError('GET :%d/api/state -> %d' % (port, status))
    return json.loads(body)


