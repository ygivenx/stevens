        print('--as must be Associate, Partner, a person id, or nobody.', file=sys.stderr)
        return 2
    via = argv[argv.index('--via') + 1] if '--via' in argv else 'firm'
    if via not in ('yours', 'firm', 'agent'):
        print('--via must be yours, firm, or agent.', file=sys.stderr)
        return 2
    skip = {'--as', '--via', '--expect', '--field', '--save', '--until', '--instance', '--scenario', '--data'}
    surface = None
    i = 0
    while i < len(argv):
        if argv[i] in skip:
            i += 2
            continue
        if not argv[i].startswith('--'):
            surface = argv[i]
            break
        i += 1
    scn = scenario_arg(argv) or 'helios'
    cfg = scenario_config(scn)
    if cfg is None:
        return fail('unknown scenario %s (helios|forge|mercy)' % scn)
    base = 'http://localhost:%d' % (cfg['personal'] if via == 'yours' else cfg['firm'])
