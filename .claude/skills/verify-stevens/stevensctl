#!/usr/bin/env python3
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request
import urllib.error

EXPECTED_MODELS = ['muse-voice-transcribe-1.0', 'muse-spark-1.3', 'muse-wonder-1.0']
ROOT = os.path.dirname(os.path.abspath(__file__ + '/../../..'))
FAKE_MODES = ['live', 'normal', 'empty', 'fail', 'garbage', 'slow']
PENDING = {
    'browser': 'day 6', 'cleanup': 'day 7', 'report': 'day 7',
}


def plus(line):
    print('+ ' + line)


def fail(message):
    print('FAIL: ' + message)
    return 1


def instance_name(argv):
    if '--instance' in argv:
        i = argv.index('--instance')
        if i + 1 >= len(argv):
            return None
        return argv[i + 1]
    return os.environ.get('STEVENS_VERIFY_INSTANCE', 'default')


def instance_dir(name):
    path = os.path.join('/tmp/stevens-verify', name)
    os.makedirs(path, exist_ok=True)
    return path


def evidence_dir(name):
    path = os.path.join(instance_dir(name), 'evidence')
    os.makedirs(path, exist_ok=True)
    return path


def port_free(port):
    for host in ('127.0.0.1', '::1'):
        family = socket.AF_INET6 if ':' in host else socket.AF_INET
        s = socket.socket(family)
        s.settimeout(2)
        try:
            s.connect((host, port))
            s.close()
            return False
        except OSError:
            pass
    return True


def http_json(method, path, role=None, timeout=30):
    headers = {}
    if role:
        headers['X-Viewer-Role'] = role
    req = urllib.request.Request('http://localhost:8787' + path, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, json.load(resp)


def stack_healthy():
    try:
        status, _ = http_json('GET', '/api/health', timeout=5)
        return status == 200
    except Exception:
        return False


def check_tool(name, want, fix):
    path = shutil.which(name)
    if not path:
        return fail('%s is missing; %s' % (name, fix))
    if name == 'node':
        out = subprocess.run([path, '--version'], capture_output=True, text=True)
        major = int(out.stdout.strip().lstrip('v').split('.')[0])
        if major < 20:
            return fail('node %s is below 20; %s' % (out.stdout.strip(), fix))
        print('ok: node %s at %s' % (out.stdout.strip(), path))
    else:
        print('ok: %s at %s' % (name, path))
    return 0


def read_key():
    env_path = os.path.join(ROOT, '.env.local')
    if not os.path.exists(env_path):
        return None
    with open(env_path) as f:
        for line in f:
            if line.startswith('MODEL_API_KEY='):
                return line.strip().split('=', 1)[1]
    return None


def cmd_doctor(argv):
    if '--help' in argv:
        print('stevensctl doctor: check tools and credentials.\n')
        print('Checks node 20+, uv, ffmpeg; MODEL_API_KEY in .env.local (never printed);')
        print('GET /v1/models lists the SPEC models; ports 5173 and 8787 state.\n')
        print('Examples:')
        print('  stevensctl doctor')
        return 0
    rc = 0
    rc |= check_tool('node', '20+', 'install node 20 or newer')
    rc |= check_tool('uv', 'any', 'install uv from docs.astral.sh/uv')
    rc |= check_tool('ffmpeg', 'any', 'install ffmpeg')
    key = read_key()
    if not key:
        rc |= fail('MODEL_API_KEY is not set in .env.local; add MODEL_API_KEY=<key>')
    else:
        print('ok: MODEL_API_KEY is set (%d chars, not shown)' % len(key))
        plus('GET https://api.meta.ai/v1/models')
        try:
            req = urllib.request.Request(
                'https://api.meta.ai/v1/models',
                headers={'Authorization': 'Bearer ' + key},
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                listed = [m['id'] for m in json.load(resp)['data']]
            missing = [m for m in EXPECTED_MODELS if m not in listed]
            if missing:
                rc |= fail('GET /v1/models lacks %s; check the key region' % ', '.join(missing))
            else:
                print('ok: GET /v1/models lists %s' % ', '.join(EXPECTED_MODELS))
        except Exception as e:
            rc |= fail('GET /v1/models failed (%s); check network and key' % e)
    for port in (5173, 8787):
        if port_free(port):
            print('ok: port %d free' % port)
        else:
            print('ok: port %d in use (verify it is this instance before stack up)' % port)
    if rc == 0:
        print('doctor: PASS')
    return rc


def stack_pidfile(name):
    return os.path.join(instance_dir(name), 'stack.pid')


def stack_logfile(name):
    return os.path.join(instance_dir(name), 'stack.log')


def stack_running(name):
    pidfile = stack_pidfile(name)
    if not os.path.exists(pidfile):
        return False
    try:
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        os.killpg(pgid, 0)
        return True
    except Exception:
        return False


def cmd_stack(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv or not argv or argv[0].startswith('--'):
        print('stevensctl stack: run the local stack for one instance.\n')
        print('Usage: stevensctl stack up|down|logs|restart|status [--instance NAME]\n')
        print('up starts npm run dev (web :5173 + server :8787) and waits for health;')
        print('down stops only this instance; logs tails its log; status prints health.\n')
        print('Examples:')
        print('  export STEVENS_VERIFY_INSTANCE=day2')
        print('  stevensctl stack up')
        print('  stevensctl stack status')
        return 0 if '--help' in argv else 2
    verb = argv[0]
    if verb == 'up':
        if stack_running(name):
            print('stack already up for instance %s' % name)
            return 0
        if not port_free(8787) or not port_free(5173):
            return fail('ports 5173/8787 are held by another stack; stop it or pick another machine (fixed ports, one stack at a time)')
        logpath = stack_logfile(name)
        plus('npm run dev > %s' % logpath)
        log = open(logpath, 'a')
        proc = subprocess.Popen(['npm', 'run', 'dev'], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        with open(stack_pidfile(name), 'w') as f:
            f.write(str(proc.pid))
        for _ in range(60):
            if stack_healthy():
                print('stack up: instance %s healthy (pgid %d)' % (name, proc.pid))
                return 0
            time.sleep(2)
        return fail('stack did not turn healthy in 120s; see stevensctl stack logs')
    if verb == 'down':
        pidfile = stack_pidfile(name)
        if not os.path.exists(pidfile):
            print('stack down: instance %s was not up' % name)
            return 0
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        plus('kill pgid %d' % pgid)
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        os.remove(pidfile)
        print('stack down: instance %s stopped' % name)
        return 0
    if verb == 'logs':
        logpath = stack_logfile(name)
        if not os.path.exists(logpath):
            return fail('no log for instance %s; run stack up first' % name)
        plus('tail -n 50 %s' % logpath)
        out = subprocess.run(['tail', '-n', '50', logpath], capture_output=True, text=True)
        print(out.stdout, end='')
        return 0
    if verb == 'restart':
        rc = cmd_stack(['down', '--instance', name])
        if rc != 0:
            return rc
        return cmd_stack(['up', '--instance', name])
    if verb == 'status':
        print('instance: %s' % name)
        print('stack process: %s' % ('up' if stack_running(name) else 'down'))
        print('port 5173: %s' % ('free' if port_free(5173) else 'in use'))
        print('port 8787: %s' % ('free' if port_free(8787) else 'in use'))
        print('health: %s' % ('ok' if stack_healthy() else 'down'))
        return 0
    print('unknown stack verb: %s (see stevensctl stack --help)' % verb, file=sys.stderr)
    return 2


def cmd_seed(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv:
        print('stevensctl seed: stage fixtures + fresh ledger for the local stack.\n')
        print('Verifies fixtures/manifest.json, truncates data/ledger.jsonl, resets the')
        print('Meta call counter, sets the fake to normal, clears derived caches.\n')
        print('Examples:')
        print('  stevensctl stack up && stevensctl seed')
        return 0
    if not stack_healthy():
        print('seed refuses: the local stack is not up (run stevensctl stack up first).', file=sys.stderr)
        return 2
    manifest = os.path.join(ROOT, 'fixtures', 'manifest.json')
    if not os.path.exists(manifest):
        return fail('fixtures/manifest.json is missing; cannot seed')
    with open(manifest) as f:
        entries = json.load(f)
    for entry in entries:
        blob = os.path.join(ROOT, 'fixtures', entry['file'])
        if not os.path.exists(blob):
            return fail('fixture blob %s is missing; cannot seed' % entry['file'])
    datadir = os.path.join(ROOT, 'data')
    os.makedirs(datadir, exist_ok=True)
    plus('truncate data/ledger.jsonl, reset meta-calls.json, fake mode normal')
    open(os.path.join(datadir, 'ledger.jsonl'), 'w').close()
    with open(os.path.join(datadir, 'meta-calls.json'), 'w') as f:
        json.dump({'count': 0}, f)
    with open(os.path.join(datadir, 'meta-fake.json'), 'w') as f:
        json.dump({'mode': 'normal'}, f)
    derived = os.path.join(datadir, 'derived')
    if os.path.exists(derived):
        shutil.rmtree(derived)
    print('seed: %d fixtures verified, ledger fresh, fake normal, counter 0' % len(entries))
    return 0


def json_path(doc, path):
    node = doc
    for part in path.split('.'):
        if '[' in part:
            key, rest = part.split('[', 1)
            idx = int(rest.rstrip(']'))
            node = node[key][idx]
        else:
            node = node[part] if isinstance(node, dict) and part in node else None
        if node is None:
            return None
    return node


def cmd_api(argv):
    if '--help' in argv or '--as' not in argv:
        print('stevensctl api: drive the app HTTP surface as a role.\n')
        print('Usage: stevensctl api --as Associate|Partner SURFACE [--expect CODE] [--field PATH] [--save FILE] [--until PATH] [--instance NAME]\n')
        print('Surfaces: health, state, ingest, extract, release/<id>, media/<id>. --field prints one JSON path; --until polls')
        print('until that path is truthy (30s); --save stores the body under evidence.\n')
        print('Examples:')
        print('  stevensctl api --as Associate state --expect 200 --field events --save state.json')
        print('  stevensctl api --as Associate ingest --expect 200')
        return 0 if '--help' in argv else 2
    role = argv[argv.index('--as') + 1]
    if role not in ('Associate', 'Partner'):
        print('--as must be Associate or Partner.', file=sys.stderr)
        return 2
    skip = {'--as', '--expect', '--field', '--save', '--until', '--instance'}
    surface = None
    i = 0
    while i < len(argv):
        if argv[i] in skip:
            i += 2
            continue
        if not argv[i].startswith('--'):
            surface = argv[i]
            break
        i += 1
    methods = {'health': ('GET', '/api/health'), 'state': ('GET', '/api/state'), 'ingest': ('POST', '/api/ingest'), 'extract': ('POST', '/api/extract')}
    raw = False
    if surface in methods:
        method, path = methods[surface]
    elif surface and surface.startswith('release/'):
        method, path = 'POST', '/api/' + surface
    elif surface and surface.startswith('media/'):
        method, path = 'GET', '/api/' + surface
        raw = True
    else:
        print('unknown surface: %s (health, state, ingest, extract, release/<id>, media/<id>).' % surface, file=sys.stderr)
        return 2
    expect = int(argv[argv.index('--expect') + 1]) if '--expect' in argv else None
    field = argv[argv.index('--field') + 1] if '--field' in argv else None
    save = argv[argv.index('--save') + 1] if '--save' in argv else None
    until = argv[argv.index('--until') + 1] if '--until' in argv else None
    name = instance_name(argv) or 'default'
    plus('%s %s as %s' % (method, path, role))
    if raw:
        req = urllib.request.Request('http://localhost:8787' + path, headers={'X-Viewer-Role': role}, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                body = {'bytes': len(resp.read()), 'contentType': resp.headers.get('Content-Type')}
                status = resp.status
        except urllib.error.HTTPError as e:
            status, body = e.code, {'error': 'http %d' % e.code}
        print(json.dumps(body))
        if expect is not None and status != expect:
            return fail('expected status %d, got %d' % (expect, status))
        return 0
    deadline = time.time() + 30
    while True:
        try:
            status, body = http_json(method, path, role, timeout=120)
        except urllib.error.HTTPError as e:
            try:
                body = json.load(e)
            except Exception:
                body = {'error': 'http %d' % e.code}
            status = e.code
        if until and not json_path(body, until) and time.time() < deadline:
            time.sleep(2)
            continue
        break
    if until and not json_path(body, until):
        return fail('--until %s never turned truthy in 30s' % until)
    if expect is not None and status != expect:
        return fail('expected status %d, got %d (%s)' % (expect, status, json.dumps(body)[:300]))
    if save:
        dest = os.path.join(evidence_dir(name), save)
        with open(dest, 'w') as f:
            json.dump(body, f, indent=2)
        print('saved %s' % dest)
    if field:
        value = json_path(body, field)
        print('%s = %s' % (field, json.dumps(value)[:500]))
        if value is None:
            return fail('field %s missing' % field)
    else:
        print(json.dumps(body)[:1000])
    return 0


def cmd_meta(argv):
    if '--help' in argv or not argv:
        print('stevensctl meta: control the Meta API fake.\n')
        print('Usage: stevensctl meta fake --mode live|normal|empty|fail|garbage|slow')
        print('       stevensctl meta calls\n')
        print('The fake stands in for api.meta.ai; calls prints the call counter the')
        print('replay and resume checks read.\n')
        print('Examples:')
        print('  stevensctl meta fake --mode slow')
        print('  stevensctl meta calls')
        print('  stevensctl meta fake --mode normal')
        return 0
    if argv[0] == 'calls':
        path = os.path.join(ROOT, 'data', 'meta-calls.json')
        count = 0
        if os.path.exists(path):
            with open(path) as f:
                count = json.load(f).get('count', 0)
        print('meta calls: %d' % count)
        return 0
    if argv[0] == 'fake' and '--mode' in argv:
        mode = argv[argv.index('--mode') + 1]
        if mode not in FAKE_MODES:
            print('unknown mode: %s (%s).' % (mode, '|'.join(FAKE_MODES)), file=sys.stderr)
            return 2
        datadir = os.path.join(ROOT, 'data')
        os.makedirs(datadir, exist_ok=True)
        with open(os.path.join(datadir, 'meta-fake.json'), 'w') as f:
            json.dump({'mode': mode}, f)
        print('meta fake: %s' % mode)
        return 0
    print('unknown meta command (see stevensctl meta --help).', file=sys.stderr)
    return 2


def cmd_evidence(argv):
    name = instance_name(argv) or 'default'
    if '--help' in argv or not argv or argv[0] not in ('dir', 'list'):
        print('stevensctl evidence: inspect this instance evidence.\n')
        print('Usage: stevensctl evidence dir|list [--instance NAME]\n')
        print('Examples:')
        print('  stevensctl evidence dir')
        return 0 if '--help' in argv or not argv else 2
    path = evidence_dir(name)
    if argv[0] == 'dir':
        print(path)
        return 0
    for entry in sorted(os.listdir(path)):
        full = os.path.join(path, entry)
        print('%s %d' % (entry, os.path.getsize(full)))
    return 0


def cmd_test(argv):
    if '--help' in argv:
        print('stevensctl test: run typecheck + vitest + build.\n')
        print('Runs the server and web typechecks, the vitest suites, and the build.')
        print('Prints one line per suite.\n')
        print('Examples:')
        print('  stevensctl test')
        return 0
    suites = [
        ('typecheck-server', ['npx', 'tsc', '-p', 'tsconfig.server.json', '--noEmit']),
        ('typecheck-web', ['npx', 'tsc', '--noEmit', '-p', 'web/tsconfig.json']),
        ('vitest', ['npm', 'test']),
        ('build', ['npm', 'run', 'build']),
    ]
    failed = []
    for label, cmd in suites:
        plus(' '.join(cmd))
        proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
        print('%s: %s' % (label, 'PASS' if proc.returncode == 0 else 'FAIL'))
        if proc.returncode != 0:
            failed.append(label)
            print(proc.stdout[-2000:] + proc.stderr[-2000:])
    if failed:
        return fail('suites failed: %s' % ', '.join(failed))
    print('test: PASS')
    return 0


def cmd_pending(name, argv):
    if '--help' in argv:
        print('stevensctl %s: not implemented until %s (see references/cli-contract.md).' % (name, PENDING[name]))
        return 0
    print('stevensctl %s is not implemented until %s.' % (name, PENDING[name]), file=sys.stderr)
    return 2


def main(argv):
    if not argv or argv[0] in ('--help', '-h', 'help'):
        print('stevensctl: verify Stevens end to end.\n')
        print('Usage: stevensctl <command> [options]\n')
        print('Commands:')
        print('  doctor    check tools, key, models, ports')
        print('  stack     up|down|logs|restart|status')
        print('  seed      stage fixtures + fresh ledger')
        print('  api       drive HTTP as a role (health, state, ingest, extract, release, media)')
        print('  browser   run|snapshot UI flows (day 6)')
        print('  test      typecheck + vitest + build')
        print('  evidence  dir|list')
        print('  cleanup   stop this instance (day 7)')
        print('  report    print the report shape (day 7)')
        print('  meta      fake --mode ... | calls\n')
        print('Examples:')
        print('  stevensctl doctor')
        print('  stevensctl stack up && stevensctl seed')
        print('  stevensctl api --as Associate ingest --expect 200')
        return 0
    name = argv[0]
    if name == 'doctor':
        return cmd_doctor(argv[1:])
    if name == 'stack':
        return cmd_stack(argv[1:])
    if name == 'seed':
        return cmd_seed(argv[1:])
    if name == 'api':
        return cmd_api(argv[1:])
    if name == 'meta':
        return cmd_meta(argv[1:])
    if name == 'evidence':
        return cmd_evidence(argv[1:])
    if name == 'test':
        return cmd_test(argv[1:])
    if name in PENDING:
        return cmd_pending(name, argv[1:])
    print('unknown command: %s (see stevensctl --help)' % name, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
