        print('Examples:')
        print('  stevensctl cleanup')
        return 0
    cmd_stack(['down', '--instance', name])
    logpath = stack_logfile(name)
    if os.path.exists(logpath):
        os.remove(logpath)
    print('cleanup: instance %s stopped, evidence kept at %s' % (name, evidence_dir(name)))
    return 0


def cmd_report(argv):
    name = instance_name(argv) or 'default'
    if '--help' in argv:
        print('stevensctl report: print the verification report shape.\n')
        print('Examples:')
        print('  stevensctl report')
        return 0
    evdir = evidence_dir(name)
    files = sorted(os.listdir(evdir)) if os.path.exists(evdir) else []
    print('# Verification report: %s' % name)
    print('\n## Stack')
    print('up' if stack_healthy() else 'down')
    print('\n## Evidence (%s)' % evdir)
    for entry in files:
        print('- %s' % entry)
    if not files:
        print('(no evidence yet)')
    print('\n## Deployed-environment differences')
    print('- Pages site served from GitHub (local open is equivalent HTML, not the served site).')
    print('- Meta API under real quota, latency, region gating (doctor checks reachability only).')
    print('- Real glasses streaming is out of scope; captures are pre-recorded files.')
    print('\n## Findings')
    print('(fill from the evidence above: blocker / should-fix / nit with file:line)')
    print('\n## Needs the user')
    print('(approvals, credentials, decisions)')
    return 0


def cmd_drop(argv):
    if '--help' in argv or not argv:
        print('stevensctl drop: land a glasses capture in the personal inbox.\n')
        print('Usage: stevensctl drop talk|slide\n')
        print('Copies the staged fixture into data/personal/inbox/; the watcher')
        print('ingests it with no UI action.\n')
        print('Examples:')
        print('  stevensctl drop talk')
        print('  stevensctl drop slide')
        return 0
    name = argv[0]
    fixtures = {'talk': 'talk.wav', 'slide': 'slide.jpg'}
    if name not in fixtures:
        print('unknown capture: %s (talk|slide).' % name, file=sys.stderr)
        return 2
    if not stack_healthy():
        print('drop refuses: the local stack is not up (run stevensctl stack up first).', file=sys.stderr)
        return 2
    src = os.path.join(ROOT, 'fixtures', 'personal', fixtures[name])
    if not os.path.exists(src):
        return fail('fixture %s is missing; cannot drop' % fixtures[name])
    inbox = os.path.join(ROOT, 'data', 'personal', 'inbox')
    os.makedirs(inbox, exist_ok=True)
    dest = os.path.join(inbox, fixtures[name])
    plus('cp %s -> %s' % (src, dest))
    shutil.copyfile(src, dest)
    print('drop: %s landed in the glasses inbox' % fixtures[name])
    return 0


def cmd_pending(name, argv):
    if '--help' in argv:
        print('stevensctl %s: not implemented until %s (see references/cli-contract.md).' % (name, PENDING[name]))
        return 0
    print('stevensctl %s is not implemented until %s.' % (name, PENDING[name]), file=sys.stderr)
    return 2


def main(argv):
    if not argv or argv[0] in ('--help', '-h', 'help'):
        print('stevensctl: verify Stevens end to end.\n')
        print('Usage: stevensctl <command> [options]\n')
        print('Commands:')
        print('  doctor    check tools, key, models, ports')
        print('  stack     up|down|logs|restart|status')
        print('  seed      stage fixtures + fresh ledger')
        print('  api       drive HTTP as a role (all surfaces; ask needs --data)')
        print('  browser   run <flow> | snapshot [--tab TAB]')
        print('  test      typecheck + vitest + build')
        print('  evidence  dir|list')
        print('  cleanup   stop this instance, keep evidence')
        print('  report    print the report shape')
        print('  meta      fake --mode ... | calls')
        print('  drop      land talk|slide in the glasses inbox\n')
        print('Examples:')
        print('  stevensctl doctor')
        print('  stevensctl stack up && stevensctl seed')
        print('  stevensctl api --as Associate ingest --expect 200')
        return 0
    name = argv[0]
    if name == 'doctor':
        return cmd_doctor(argv[1:])
    if name == 'stack':
        return cmd_stack(argv[1:])
    if name == 'seed':
        return cmd_seed(argv[1:])
    if name == 'api':
        return cmd_api(argv[1:])
    if name == 'meta':
        return cmd_meta(argv[1:])
    if name == 'drop':
        return cmd_drop(argv[1:])
    if name == 'evidence':
        return cmd_evidence(argv[1:])
    if name == 'test':
        return cmd_test(argv[1:])
    if name == 'browser':
        return cmd_browser(argv[1:])
    if name == 'cleanup':
        return cmd_cleanup(argv[1:])
    if name == 'report':
        return cmd_report(argv[1:])
    if name in PENDING:
        return cmd_pending(name, argv[1:])
    print('unknown command: %s (see stevensctl --help)' % name, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
