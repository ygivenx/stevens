#!/usr/bin/env python3
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request
import urllib.error

EXPECTED_MODELS = ['muse-voice-transcribe-1.0', 'muse-spark-1.3', 'muse-wonder-1.0']
ROOT = os.path.dirname(os.path.abspath(__file__ + '/../../..'))
FAKE_MODES = ['live', 'normal', 'empty', 'fail', 'garbage', 'slow']
PENDING = {}


def plus(line):
    print('+ ' + line)


def fail(message):
    print('FAIL: ' + message)
    return 1


def instance_name(argv):
    if '--instance' in argv:
        i = argv.index('--instance')
        if i + 1 >= len(argv):
            return None
        return argv[i + 1]
    return os.environ.get('STEVENS_VERIFY_INSTANCE', 'default')


def instance_dir(name):
    path = os.path.join('/tmp/stevens-verify', name)
    os.makedirs(path, exist_ok=True)
    return path


def evidence_dir(name):
    path = os.path.join(instance_dir(name), 'evidence')
    os.makedirs(path, exist_ok=True)
    return path


def port_free(port):
    for host in ('127.0.0.1', '::1'):
        family = socket.AF_INET6 if ':' in host else socket.AF_INET
        s = socket.socket(family)
        s.settimeout(2)
        try:
            s.connect((host, port))
            s.close()
            return False
        except OSError:
            pass
    return True


def read_agent_token():
    env_path = os.path.join(ROOT, '.env.local')
    if not os.path.exists(env_path):
        return None
    with open(env_path) as f:
        for line in f:
            if line.startswith('STEVENS_AGENT_TOKEN='):
                return line.strip().split('=', 1)[1]
    return None


def http_json(method, path, role=None, timeout=30, data=None, base='http://localhost:8787', agent=False):
    headers = {}
    if agent:
        if role != 'nobody':
            token = read_agent_token()
            if token:
                headers['X-Stevens-Agent'] = token
    elif role:
        headers['X-Viewer-Role'] = role
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        headers['Content-Type'] = 'application/json'
    req = urllib.request.Request(base + path, data=body, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, json.load(resp)


def server_healthy(port):
    try:
        req = urllib.request.Request('http://localhost:%d/api/health' % port)
        with urllib.request.urlopen(req, timeout=5) as resp:
            return resp.status == 200
    except Exception:
        return False


def stack_healthy():
    return server_healthy(8787) and server_healthy(8788)


def check_tool(name, want, fix):
    path = shutil.which(name)
    if not path:
        return fail('%s is missing; %s' % (name, fix))
    if name == 'node':
        out = subprocess.run([path, '--version'], capture_output=True, text=True)
        major = int(out.stdout.strip().lstrip('v').split('.')[0])
        if major < 20:
            return fail('node %s is below 20; %s' % (out.stdout.strip(), fix))
        print('ok: node %s at %s' % (out.stdout.strip(), path))
    else:
        print('ok: %s at %s' % (name, path))
    return 0


def read_key():
    env_path = os.path.join(ROOT, '.env.local')
    if not os.path.exists(env_path):
        return None
    with open(env_path) as f:
        for line in f:
            if line.startswith('MODEL_API_KEY='):
                return line.strip().split('=', 1)[1]
    return None


def cmd_doctor(argv):
    if '--help' in argv:
        print('stevensctl doctor: check tools and credentials.\n')
        print('Checks node 20+, uv, ffmpeg; MODEL_API_KEY in .env.local (never printed);')
        print('GET /v1/models lists the SPEC models; ports 5173, 5174, 8787 and 8788 state.\n')
        print('Examples:')
        print('  stevensctl doctor')
        return 0
    rc = 0
    rc |= check_tool('node', '20+', 'install node 20 or newer')
    rc |= check_tool('uv', 'any', 'install uv from docs.astral.sh/uv')
    rc |= check_tool('ffmpeg', 'any', 'install ffmpeg')
    key = read_key()
    if not key:
        rc |= fail('MODEL_API_KEY is not set in .env.local; add MODEL_API_KEY=<key>')
    else:
        print('ok: MODEL_API_KEY is set (%d chars, not shown)' % len(key))
        plus('GET https://api.meta.ai/v1/models')
        try:
            req = urllib.request.Request(
                'https://api.meta.ai/v1/models',
                headers={'Authorization': 'Bearer ' + key},
            )
            with urllib.request.urlopen(req, timeout=20) as resp:
                listed = [m['id'] for m in json.load(resp)['data']]
            missing = [m for m in EXPECTED_MODELS if m not in listed]
            if missing:
                rc |= fail('GET /v1/models lacks %s; check the key region' % ', '.join(missing))
            else:
                print('ok: GET /v1/models lists %s' % ', '.join(EXPECTED_MODELS))
        except Exception as e:
            rc |= fail('GET /v1/models failed (%s); check network and key' % e)
    for port in (5173, 5174, 8787, 8788):
        if port_free(port):
            print('ok: port %d free' % port)
        else:
            print('ok: port %d in use (verify it is this instance before stack up)' % port)
    if rc == 0:
        print('doctor: PASS')
    return rc


def stack_pidfile(name):
    return os.path.join(instance_dir(name), 'stack.pid')


def stack_logfile(name):
    return os.path.join(instance_dir(name), 'stack.log')


def stack_running(name):
    pidfile = stack_pidfile(name)
    if not os.path.exists(pidfile):
        return False
    try:
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        os.killpg(pgid, 0)
        return True
    except Exception:
        return False


def cmd_stack(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv or not argv or argv[0].startswith('--'):
        print('stevensctl stack: run the local stack for one instance.\n')
        print('Usage: stevensctl stack up|down|logs|restart|status [--instance NAME]\n')
        print('up starts npm run dev (yours :5173+:8788, firm :5174+:8787) and waits for health;')
        print('down stops only this instance; logs tails its log; status prints health.\n')
        print('Examples:')
        print('  export STEVENS_VERIFY_INSTANCE=day2')
        print('  stevensctl stack up')
        print('  stevensctl stack status')
        return 0 if '--help' in argv else 2
    verb = argv[0]
    if verb == 'up':
        if stack_running(name):
            print('stack already up for instance %s' % name)
            return 0
        if not all(port_free(port) for port in (5173, 5174, 8787, 8788)):
            return fail('ports 5173/5174/8787/8788 are held by another stack; stop it or pick another machine (fixed ports, one stack at a time)')
        logpath = stack_logfile(name)
        plus('npm run dev > %s' % logpath)
        log = open(logpath, 'a')
        proc = subprocess.Popen(['npm', 'run', 'dev'], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        with open(stack_pidfile(name), 'w') as f:
            f.write(str(proc.pid))
        for _ in range(60):
            if stack_healthy():
                print('stack up: instance %s healthy (pgid %d)' % (name, proc.pid))
                return 0
            time.sleep(2)
        return fail('stack did not turn healthy in 120s; see stevensctl stack logs')
    if verb == 'down':
        pidfile = stack_pidfile(name)
        if not os.path.exists(pidfile):
            print('stack down: instance %s was not up' % name)
            return 0
        with open(pidfile) as f:
            pgid = int(f.read().strip())
        plus('kill pgid %d' % pgid)
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        os.remove(pidfile)
        print('stack down: instance %s stopped' % name)
        return 0
    if verb == 'logs':
        logpath = stack_logfile(name)
        if not os.path.exists(logpath):
            return fail('no log for instance %s; run stack up first' % name)
        plus('tail -n 50 %s' % logpath)
        out = subprocess.run(['tail', '-n', '50', logpath], capture_output=True, text=True)
        print(out.stdout, end='')
        return 0
    if verb == 'restart':
        rc = cmd_stack(['down', '--instance', name])
        if rc != 0:
            return rc
        for _ in range(30):
            if all(port_free(port) for port in (5173, 5174, 8787, 8788)):
                break
            time.sleep(1)
        return cmd_stack(['up', '--instance', name])
    if verb == 'status':
        print('instance: %s' % name)
        print('stack process: %s' % ('up' if stack_running(name) else 'down'))
        print('port 5173 (yours web): %s' % ('free' if port_free(5173) else 'in use'))
        print('port 5174 (firm web): %s' % ('free' if port_free(5174) else 'in use'))
        print('port 8787 (firm): %s' % ('free' if port_free(8787) else 'in use'))
        print('port 8788 (yours): %s' % ('free' if port_free(8788) else 'in use'))
        print('health firm :8787: %s' % ('ok' if server_healthy(8787) else 'down'))
        print('health yours :8788: %s' % ('ok' if server_healthy(8788) else 'down'))
        return 0
    print('unknown stack verb: %s (see stevensctl stack --help)' % verb, file=sys.stderr)
    return 2


def cmd_seed(argv):
    name = instance_name(argv)
    if name is None or '--help' in argv:
        print('stevensctl seed: stage fixtures + fresh ledger for the local stack.\n')
        print('Verifies fixtures/manifest.json, truncates both process ledgers, resets the')
        print('Meta call counter, sets the fake to normal, clears derived caches.\n')
        print('Examples:')
        print('  stevensctl stack up && stevensctl seed')
        return 0
    if not stack_healthy():
        print('seed refuses: the local stack is not up (run stevensctl stack up first).', file=sys.stderr)
        return 2
    manifest = os.path.join(ROOT, 'fixtures', 'manifest.json')
    if not os.path.exists(manifest):
        return fail('fixtures/manifest.json is missing; cannot seed')
    with open(manifest) as f:
        entries = json.load(f)
    for entry in entries:
        blob = os.path.join(ROOT, 'fixtures', entry['file'])
        if not os.path.exists(blob):
            return fail('fixture blob %s is missing; cannot seed' % entry['file'])
    datadir = os.path.join(ROOT, 'data')
    os.makedirs(datadir, exist_ok=True)
    plus('truncate both ledgers, clear databases and caches, fake mode normal')
    for processdir in ('firm', 'personal'):
        processdir_path = os.path.join(datadir, processdir)
        os.makedirs(processdir_path, exist_ok=True)
        open(os.path.join(processdir_path, 'ledger.jsonl'), 'w').close()
        for stale in ('firm.db', 'personal.db', 'stage-cache', 'work'):
            stale_path = os.path.join(processdir_path, stale)
            if os.path.isdir(stale_path):
                shutil.rmtree(stale_path)
            elif os.path.exists(stale_path):
                os.remove(stale_path)
    inbox = os.path.join(datadir, 'personal', 'inbox')
    os.makedirs(inbox, exist_ok=True)
    for name in os.listdir(inbox):
        name_path = os.path.join(inbox, name)
        if os.path.isfile(name_path):
            os.remove(name_path)
        with open(os.path.join(datadir, processdir, 'meta-calls.json'), 'w') as f:
            json.dump({'count': 0}, f)
        with open(os.path.join(datadir, processdir, 'meta-fake.json'), 'w') as f:
            json.dump({'mode': 'normal'}, f)
    with open(os.path.join(datadir, 'meta-calls.json'), 'w') as f:
        json.dump({'count': 0}, f)
    with open(os.path.join(datadir, 'meta-fake.json'), 'w') as f:
        json.dump({'mode': 'normal'}, f)
    derived = os.path.join(datadir, 'derived')
    if os.path.exists(derived):
        shutil.rmtree(derived)
    print('seed: %d fixtures verified, state fresh, fake normal, counter 0' % len(entries))
    print('seed: restarting the stack so both processes rebuild from fixtures')
    return cmd_stack(['restart', '--instance', name])


def json_path(doc, path):
    node = doc
    for part in path.split('.'):
        if '[' in part:
            key, rest = part.split('[', 1)
            idx = int(rest.rstrip(']'))
            node = node[key][idx]
        else:
            node = node[part] if isinstance(node, dict) and part in node else None
        if node is None:
            return None
    return node


def cmd_api(argv):
    if '--help' in argv or '--as' not in argv:
        print('stevensctl api: drive the app HTTP surface as a role.\n')
        print('Usage: stevensctl api --as Associate|Partner [--via yours|firm|agent] SURFACE [--expect CODE] [--field PATH] [--save FILE] [--until PATH] [--instance NAME]\n')
        print('Surfaces (yours :8788): health, state, items/<id>, ask, share/<claimId>, receipts/<id>.')
        print('Surfaces (firm :8787): health, state, approve/<id>, reject/<id>, media/<id>.')
        print('Surfaces (agent :8787): me, meetings, context, privy.')
        print('Legacy v2.1 surfaces (firm :8787): ingest, extract, bridge, brief, ask, switch, transcript/<id>, release/<id>.')
        print('--field prints one JSON path; --until polls until it is truthy (30s); --data sends a JSON body; --save stores it.')
        print('until that path is truthy (30s); --save stores the body under evidence.\n')
        print('Examples:')
        print('  stevensctl api --as Associate state --expect 200 --field events --save state.json')
        print('  stevensctl api --as Associate ingest --expect 200')
        return 0 if '--help' in argv else 2
    role = argv[argv.index('--as') + 1]
    if role not in ('Associate', 'Partner', 'p-alex', 'p-morgan', 'nobody'):
        print('--as must be Associate, Partner, p-alex, p-morgan, or nobody.', file=sys.stderr)
        return 2
    via = argv[argv.index('--via') + 1] if '--via' in argv else 'firm'
    if via not in ('yours', 'firm', 'agent'):
        print('--via must be yours, firm, or agent.', file=sys.stderr)
        return 2
    skip = {'--as', '--via', '--expect', '--field', '--save', '--until', '--instance', '--data'}
    surface = None
    i = 0
    while i < len(argv):
        if argv[i] in skip:
            i += 2
            continue
        if not argv[i].startswith('--'):
            surface = argv[i]
            break
        i += 1
    base = 'http://localhost:8788' if via == 'yours' else 'http://localhost:8787'
    agent = via == 'agent'
    methods = {'health': ('GET', '/api/health'), 'state': ('GET', '/api/state'), 'ingest': ('POST', '/api/ingest'), 'extract': ('POST', '/api/extract'), 'bridge': ('POST', '/api/bridge'), 'brief': ('POST', '/api/brief'), 'ask': ('POST', '/api/ask'), 'switch': ('POST', '/api/switch')}
    raw = False
    if agent and surface == 'me':
        method, path = 'GET', '/agent/me'
    elif agent and surface == 'meetings':
        method, path = 'GET', '/agent/meetings?withinHours=72'
    elif agent and surface == 'context':
        method, path = 'GET', '/agent/context?dealId=helios&purpose=answer'
    elif agent and surface == 'privy':
        method, path = 'POST', '/agent/privy'
    elif not agent and via == 'yours' and surface == 'ask':
        method, path = 'POST', '/api/ask'
    elif not agent and via == 'yours' and surface and surface.startswith('share/'):
        method, path = 'POST', '/api/' + surface
    elif not agent and via == 'yours' and surface and surface.startswith('items/'):
        method, path = 'GET', '/api/' + surface
    elif not agent and via == 'yours' and surface and surface.startswith('receipts/'):
        method, path = 'GET', '/api/' + surface
    elif surface in methods:
        method, path = methods[surface]
    elif surface and surface.startswith('release/'):
        method, path = 'POST', '/api/' + surface
    elif surface and (surface.startswith('approve/') or surface.startswith('reject/')):
        method, path = 'POST', '/api/' + surface
    elif surface and surface.startswith('transcript/'):
        method, path = 'GET', '/api/' + surface
    elif surface and surface.startswith('media/'):
        method, path = 'GET', '/api/' + surface
        raw = True
    else:
        print('unknown surface for --via %s: %s.' % (via, surface), file=sys.stderr)
        return 2
    expect = int(argv[argv.index('--expect') + 1]) if '--expect' in argv else None
    field = argv[argv.index('--field') + 1] if '--field' in argv else None
    save = argv[argv.index('--save') + 1] if '--save' in argv else None
    until = argv[argv.index('--until') + 1] if '--until' in argv else None
    data = json.loads(argv[argv.index('--data') + 1]) if '--data' in argv else None
    name = instance_name(argv) or 'default'
    plus('%s %s%s as %s' % (method, base, path, role))
    try:
        http_json('GET', '/api/health', timeout=5, base=base)
    except Exception:
        print('api refuses: the local stack is not up (run stevensctl stack up first).', file=sys.stderr)
        return 2
    if raw:
        raw_headers = {}
        if agent:
            token = read_agent_token()
            if token and role != 'nobody':
                raw_headers['X-Stevens-Agent'] = token
        else:
            raw_headers['X-Viewer-Role'] = role
        req = urllib.request.Request(base + path, headers=raw_headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                body = {'bytes': len(resp.read()), 'contentType': resp.headers.get('Content-Type')}
                status = resp.status
        except urllib.error.HTTPError as e:
            status, body = e.code, {'error': 'http %d' % e.code}
        print(json.dumps(body))
        if expect is not None and status != expect:
            return fail('expected status %d, got %d' % (expect, status))
        return 0
    deadline = time.time() + 30
    while True:
        try:
            status, body = http_json(method, path, role, timeout=300, data=data, base=base, agent=agent)
        except urllib.error.HTTPError as e:
            try:
                body = json.load(e)
            except Exception:
                body = {'error': 'http %d' % e.code}
            status = e.code
        if until and not json_path(body, until) and time.time() < deadline:
            time.sleep(2)
            continue
        break
    if until and not json_path(body, until):
        return fail('--until %s never turned truthy in 30s' % until)
    if expect is not None and status != expect:
        return fail('expected status %d, got %d (%s)' % (expect, status, json.dumps(body)[:300]))
    if save:
        dest = os.path.join(evidence_dir(name), save)
        with open(dest, 'w') as f:
            json.dump(body, f, indent=2)
        print('saved %s' % dest)
    if field:
        value = json_path(body, field)
        print('%s = %s' % (field, json.dumps(value)[:500]))
        if value is None:
            return fail('field %s missing' % field)
    else:
        print(json.dumps(body)[:1000])
    return 0


def cmd_meta(argv):
    if '--help' in argv or not argv:
        print('stevensctl meta: control the Meta API fake.\n')
        print('Usage: stevensctl meta fake --mode live|normal|empty|fail|garbage|slow')
        print('       stevensctl meta calls\n')
        print('The fake stands in for api.meta.ai; calls prints the call counter the')
        print('replay and resume checks read.\n')
        print('Examples:')
        print('  stevensctl meta fake --mode slow')
        print('  stevensctl meta calls')
        print('  stevensctl meta fake --mode normal')
        return 0
    if argv[0] == 'calls':
        total = 0
        for processdir in ('firm', 'personal'):
            path = os.path.join(ROOT, 'data', processdir, 'meta-calls.json')
            if os.path.exists(path):
                with open(path) as f:
                    total += json.load(f).get('count', 0)
        print('meta calls: %d' % total)
        return 0
    if argv[0] == 'fake' and '--mode' in argv:
        mode = argv[argv.index('--mode') + 1]
        if mode not in FAKE_MODES:
            print('unknown mode: %s (%s).' % (mode, '|'.join(FAKE_MODES)), file=sys.stderr)
            return 2
        for processdir in ('firm', 'personal'):
            processdatadir = os.path.join(ROOT, 'data', processdir)
            os.makedirs(processdatadir, exist_ok=True)
            with open(os.path.join(processdatadir, 'meta-fake.json'), 'w') as f:
                json.dump({'mode': mode}, f)
        print('meta fake: %s' % mode)
        return 0
    print('unknown meta command (see stevensctl meta --help).', file=sys.stderr)
    return 2


