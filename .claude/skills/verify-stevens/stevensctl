PG_NODE = (
    "const { Client } = require('pg');"
    "(async () => {"
    " const client = new Client({ connectionString: process.env.PGURL, connectionTimeoutMillis: 8000 });"
    " await client.connect();"
    " const res = await client.query(process.argv[1]);"
    " console.log(JSON.stringify({ rows: res.rows, rowCount: res.rowCount }));"
    " await client.end();"
    "})().catch((e) => { console.error(e.message); process.exit(1); });"
)


def read_env_value(key):
    env_path = os.path.join(ROOT, '.env.local')
    if not os.path.exists(env_path):
        return None
    with open(env_path) as f:
        for line in f:
            if line.startswith(key + '='):
                return line.strip().split('=', 1)[1]
    return None


def write_env_value(key, value):
    env_path = os.path.join(ROOT, '.env.local')
    lines = []
    if os.path.exists(env_path):
        with open(env_path) as f:
            lines = [line for line in f.read().split('\n') if not line.startswith(key + '=')]
    while lines and lines[-1] == '':
        lines.pop()
    lines.append(key + '=' + value)
    with open(env_path, 'w') as f:
        f.write('\n'.join(lines) + '\n')


def pg_run(url, sql):
    env = dict(os.environ)
    env['PGURL'] = url
    return subprocess.run(['node', '-e', PG_NODE, sql], cwd=ROOT, capture_output=True, text=True, env=env, timeout=30)


def pg_ok(url):
    try:
        result = pg_run(url, 'select 1 as one')
    except Exception:
        return False
    if result.returncode != 0:
        return False
    try:
        return json.loads(result.stdout)['rows'] == [{'one': 1}]
    except Exception:
        return False


