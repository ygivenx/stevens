def crm_grantee(principal):
    if principal == 'all-staff':
        return 'dh_all_staff'
    if principal == 'partners':
        return 'dh_partners'
    team = re.match(r'^deal-team:(.+)$', principal)
    if team:
        return 'dh_deal_team_' + re.sub(r'[^a-z0-9_]', '_', team.group(1))
    hold = re.match(r'^legal-hold:(.+)$', principal)
    if hold:
        return 'dh_legal_hold_' + re.sub(r'[^a-z0-9_]', '_', hold.group(1))
    return None


def cmd_crm(argv):
    if len(argv) != 3 or argv[0] not in ('grant', 'revoke') or '--help' in argv:
