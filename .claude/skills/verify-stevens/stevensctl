def default_data_dir():
    home = os.path.expanduser('~')
    if sys.platform == 'darwin':
        return os.path.join(home, 'Library', 'Application Support', 'Stevens')
    xdg = os.environ.get('XDG_DATA_HOME') or os.path.join(home, '.local', 'share')
    return os.path.join(xdg, 'stevens')


def read_env_values():
    env_path = os.path.join(ROOT, '.env.local')
    entries = {}
    if not os.path.exists(env_path):
        return entries
    with open(env_path) as f:
        for line in f:
            if '=' in line and not line.startswith('#'):
                key, value = line.strip().split('=', 1)
                entries[key] = value
    return entries


def write_env_updates(updates):
    env_path = os.path.join(ROOT, '.env.local')
    lines = []
    if os.path.exists(env_path):
        with open(env_path) as f:
            lines = f.read().splitlines()
    seen = set()
    out = []
    for line in lines:
        if '=' in line and not line.startswith('#'):
            key = line.split('=', 1)[0]
            if key in updates:
                out.append('%s=%s' % (key, updates[key]))
                seen.add(key)
                continue
        out.append(line)
    for key, value in updates.items():
        if key not in seen:
            out.append('%s=%s' % (key, value))
    with open(env_path, 'w') as f:
        f.write('\n'.join(out) + '\n')


def vault_counts(root, excludes):
    taken = 0
    skipped = 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith('.')]
        for filename in filenames:
            if not filename.endswith('.md'):
                continue
            rel = os.path.relpath(os.path.join(dirpath, filename), root)
            if any(rel == prefix or rel.startswith(prefix + '/') for prefix in excludes):
                skipped += 1
                continue
            try:
                with open(os.path.join(dirpath, filename)) as f:
                    head = f.read(2000)
            except OSError:
                skipped += 1
                continue
            if re.match(r'^---\r?\n', head):
                front = head.split('---', 2)
                if len(front) > 2 and re.search(r'(?m)^stevens:\s*skip\s*$', front[1]):
                    skipped += 1
                    continue
            taken += 1
    return taken, skipped


def calendar_week_count(body):
    now = datetime.datetime.now(datetime.timezone.utc)
    end = now + datetime.timedelta(days=7)
    count = 0
    for match in re.finditer(r'DTSTART[^:]*:(\d{8}T\d{6})(Z?)', body):
        stamp, zoned = match.group(1), match.group(2)
        try:
            moment = datetime.datetime.strptime(stamp, '%Y%m%dT%H%M%S')
        except ValueError:
            continue
        if zoned:
            moment = moment.replace(tzinfo=datetime.timezone.utc)
        else:
            moment = moment.astimezone().astimezone(datetime.timezone.utc)
        if now <= moment <= end:
            count += 1
    return count


def cmd_init(argv):
    if '--help' in argv:
        print('stevensctl init: configure Stevens for a real owner.\n')
        print('Usage: stevensctl init [--data-dir DIR] [--vault-dir DIR] [--vault-exclude CSV]')
        print('  [--inbox-dir DIR] [--readwise-token TOKEN] [--calendar-ics URL] [--firm-url URL|off]')
        print('  [--owner NAME] [--backfill-days N] [--daily-tokens N]\n')
        print('Writes .env.local (merged, other keys kept), checks MODEL_API_KEY plus each')
        print('source, and prints one line per source without ever printing a token or URL.')
        print('Missing values prompt in a terminal; elsewhere they are an error. --firm-url')
        print('off (the default) means solo mode: no firm checks run.\n')
        print('Examples:')
        print('  stevensctl init --vault-dir ~/notes --owner "Alex Rivera"')
        print('  stevensctl init --firm-url http://localhost:8787 --owner p-alex')
        return 0
    flag_for = {flag: key for flag, key in INIT_FLAGS}
    flagged = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if '=' in arg and arg.split('=', 1)[0] in flag_for:
            flag, value = arg.split('=', 1)
            flagged[flag_for[flag]] = value
            i += 1
        elif arg in flag_for:
            if i + 1 >= len(argv):
                print('init: %s needs a value.' % arg, file=sys.stderr)
                return 2
            flagged[flag_for[arg]] = argv[i + 1]
            i += 2
        else:
            print('unknown init flag: %s (see stevensctl init --help).' % arg, file=sys.stderr)
            return 2
    current = read_env_values()
    values = dict(current)
    values.update(flagged)
    if 'STEVENS_DATA_DIR' not in values or not values['STEVENS_DATA_DIR']:
        values['STEVENS_DATA_DIR'] = default_data_dir()
    if 'STEVENS_FIRM_URL' not in values or not values['STEVENS_FIRM_URL']:
        values['STEVENS_FIRM_URL'] = 'off'
    if 'STEVENS_BACKFILL_DAYS' not in values or not values['STEVENS_BACKFILL_DAYS']:
        values['STEVENS_BACKFILL_DAYS'] = '90'
    if 'STEVENS_DAILY_TOKENS' not in values or not values['STEVENS_DAILY_TOKENS']:
        values['STEVENS_DAILY_TOKENS'] = '3000000'
    tty = sys.stdin.isatty()
    for key, label in (('STEVENS_VAULT_DIR', 'vault dir'), ('STEVENS_OWNER', 'owner name')):
        if key not in values or not values[key]:
            if not tty:
                print('init needs --%s (or run in a terminal).' % label.replace(' ', '-'), file=sys.stderr)
                return 2
            values[key] = input('%s: ' % label).strip()
            if not values[key]:
                print('init: %s is required.' % label, file=sys.stderr)
                return 2
    if tty:
        for key, label in (('STEVENS_INBOX_DIR', 'inbox dir (empty skips)'),
                            ('STEVENS_VAULT_EXCLUDE', 'vault exclude prefixes (empty skips)'),
                            ('READWISE_TOKEN', 'Readwise token (empty skips)'),
                            ('STEVENS_CALENDAR_ICS', 'calendar ICS URL (empty skips)')):
            if key not in values or not values[key]:
                values[key] = input('%s: ' % label).strip()
    for key in ('STEVENS_DATA_DIR', 'STEVENS_VAULT_DIR', 'STEVENS_INBOX_DIR'):
        if values.get(key):
            values[key] = os.path.abspath(os.path.expanduser(values[key]))
    updates = {flag: values[flag] for _, flag in INIT_FLAGS if values.get(flag)}
    plus('write %d keys to .env.local (other keys kept)' % len(updates))
    write_env_updates(updates)
    failed = []

    def report(source, ok, detail):
        print('%s: %s %s' % (source, 'OK' if ok else 'FAIL', detail))
        if not ok:
            failed.append(source)

    key = read_env_values().get('MODEL_API_KEY', '')
    if not key:
        report('key', False, 'MODEL_API_KEY is not set; add it to .env.local by hand')
    else:
        try:
            req = urllib.request.Request('https://api.meta.ai/v1/models', headers={'Authorization': 'Bearer ' + key})
            with urllib.request.urlopen(req, timeout=20) as resp:
                listed = [m['id'] for m in json.load(resp)['data']]
            missing = [m for m in EXPECTED_MODELS if m not in listed]
            if missing:
                report('key', False, 'GET /v1/models lacks %s' % ', '.join(missing))
            else:
                report('key', True, 'GET /v1/models lists the SPEC models')
        except Exception as e:
            report('key', False, 'GET /v1/models failed (%s)' % e)
    vault = values.get('STEVENS_VAULT_DIR', '')
    if not os.path.isdir(vault):
        report('vault', False, '%s is not a directory' % vault)
    else:
        excludes = [p for p in values.get('STEVENS_VAULT_EXCLUDE', '').split(',') if p.strip()]
        taken, skipped = vault_counts(vault, [p.strip().rstrip('/') for p in excludes])
        report('vault', True, '%d notes (%d excluded) at %s' % (taken, skipped, vault))
    inbox = values.get('STEVENS_INBOX_DIR', '')
    if inbox:
        try:
            os.makedirs(inbox, exist_ok=True)
        except OSError as e:
            report('inbox', False, '%s (%s)' % (inbox, e))
        else:
            if not os.access(inbox, os.W_OK):
                report('inbox', False, '%s is not writable' % inbox)
            else:
                waiting = sum(1 for n in os.listdir(inbox) if os.path.isfile(os.path.join(inbox, n)))
                report('inbox', True, '%s (%d files waiting)' % (inbox, waiting))
    else:
        print('inbox: SKIP not configured')
    token = values.get('READWISE_TOKEN', '')
    if token:
        try:
            req = urllib.request.Request('https://readwise.io/api/v2/auth/', headers={'Authorization': 'Token ' + token})
            with urllib.request.urlopen(req, timeout=20) as resp:
                if resp.status == 204:
                    report('readwise', True, 'live account reachable')
                else:
                    report('readwise', False, 'auth returned %d' % resp.status)
        except Exception as e:
            report('readwise', False, 'auth failed (%s)' % e)
    else:
        print('readwise: SKIP not configured (export file)')
    calendar = values.get('STEVENS_CALENDAR_ICS', '')
    if calendar:
        try:
            with urllib.request.urlopen(calendar, timeout=20) as resp:
                count = calendar_week_count(resp.read().decode('utf-8', 'replace'))
            report('calendar', True, '%d events in the next 7 days' % count)
        except Exception as e:
            report('calendar', False, 'fetch failed (%s)' % e)
    else:
        print('calendar: SKIP not configured')
