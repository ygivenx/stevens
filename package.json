{
  "name": "stevens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n firm-server,personal-server,personal-web,firm-web \"npm run dev:server:firm\" \"npm run dev:server:personal\" \"npm run dev:web:personal\" \"npm run dev:web:firm\"",
    "dev:server:firm": "STEVENS_DEV=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/firm/index.ts",
    "dev:server:personal": "STEVENS_DEV=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/personal/index.ts",
    "dev:web:personal": "npm run dev:personal --workspace web",
    "dev:web:firm": "npm run dev:firm --workspace web",
    "build": "npm run build --workspace web && tsc -p tsconfig.server.json",
    "start": "concurrently -n firm,personal \"npm run start:firm\" \"npm run start:personal\"",
    "start:firm": "node dist-server/server/firm/index.js",
    "start:personal": "node dist-server/server/personal/index.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/pg": "^8.23.1",
    "hono": "^4.7.0",
    "ical.js": "^2.2.1",
    "openai": "^7.45.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
