{
  "name": "stevens-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:personal": "vite --config vite.personal.config.ts",
    "dev:firm": "vite --config vite.firm.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.personal.config.ts --outDir ../dist-web-personal && vite build --config vite.firm.config.ts --outDir ../dist-web-firm",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7"
  }
}
